<Window x:Class="Worm.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:tb="http://schemas.hardcodet.net/package/2015/wpf/notifyicon"
        mc:Ignorable="d"
        Title="Worm" Height="680" Width="980"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WormLoamBackground}"
        ui:WindowHelper.UseModernWindowStyle="True">

    <Grid>
        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Worm - System Monitor &amp; Cleaner"
                        IconSource="AppIcon.ico"
                        TrayLeftMouseDown="TrayIcon_TrayLeftMouseDown">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="#201D1A" Foreground="#F2EFE9">
                    <MenuItem Header="Open Worm" Click="OpenWindow_Click" FontWeight="SemiBold"/>
                    <Separator Background="#332E29"/>
                    <MenuItem Header="Quick Clean" Click="QuickClean_Click"/>
                    <Separator Background="#332E29"/>
                    <MenuItem Header="Exit" Click="ExitApp_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <ui:NavigationView x:Name="NavView"
                           IsSettingsVisible="True"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           SelectionChanged="NavView_SelectionChanged"
                           Background="Transparent">

            <!-- Custom App Header with Mascot & Title -->
            <ui:NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Margin="14,14,0,10">
                    <Image Source="AppIcon_512.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Worm" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource WormIvoryText}" 
                               Margin="10,2,0,0"/>
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <!-- Navigation Items matching macOS app -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Clean" Tag="Clean" Icon="Delete"/>
                <ui:NavigationViewItem Content="Leftovers" Tag="Leftovers" Icon="Folder"/>
                <ui:NavigationViewItem Content="Hardware Status" Tag="Status" Icon="SpeedHigh"/>
            </ui:NavigationView.MenuItems>

            <!-- Content Area -->
            <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>

        </ui:NavigationView>
    </Grid>
</Window>
