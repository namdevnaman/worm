<Page x:Class="Worm.UI.LeftoversPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Leftovers"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Fixed, not a split view: a splitter pushes the list to the bottom. -->
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ List pane ============================ -->
        <Grid Grid.Column="0" Background="{StaticResource LoamSurface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12,12,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Leftovers" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"/>
                    <TextBlock Style="{StaticResource Subtitle}"
                               Text="Data left behind by apps you removed. Nothing is deleted until you choose it."/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnRescan" Content="Scan"
                        Click="BtnRescan_Click" Style="{StaticResource GhostButton}"
                        VerticalAlignment="Top" Padding="8,3"/>
            </Grid>

            <Grid Grid.Row="1" Margin="12,0,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFilter" Grid.Column="0" Margin="0,0,8,0"
                         Padding="8,5" FontSize="11"
                         Foreground="{StaticResource Ink}"
                         CaretBrush="{StaticResource Accent}"
                         Background="{StaticResource LoamBackground}"
                         BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                         TextChanged="TxtFilter_TextChanged"/>
                <CheckBox Grid.Column="1" x:Name="ChkReviewOnly" Content="Needs review"
                          VerticalAlignment="Center" Margin="0,0,8,0"
                          Foreground="{StaticResource InkSecondary}" FontSize="10"
                          Checked="ChkReviewOnly_Changed" Unchecked="ChkReviewOnly_Changed"/>
                <Button Grid.Column="2" x:Name="BtnSelectAll" Content="All"
                        Click="BtnSelectAll_Click" Style="{StaticResource GhostButton}"
                        Padding="8,3" VerticalAlignment="Center"/>
            </Grid>

            <!-- States -->
            <Grid Grid.Row="2">
                <ContentControl x:Name="PanelLoading" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <ContentControl x:Name="PanelEmpty" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <ScrollViewer x:Name="PanelList" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GroupHost" Margin="8,0,8,12"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Divider -->
        <Border Grid.Column="1" Background="{StaticResource Hairline}"/>

        <!-- =========================== Detail pane =========================== -->
        <Grid Grid.Column="2" Background="{StaticResource LoamBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">

                    <TextBlock Text="Selection" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Margin="0,10,0,0">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Items" Style="{StaticResource BodyText}"/>
                            <TextBlock x:Name="StatItems" Grid.Column="1" FontSize="12"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource Ink}" Text="0"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Size" Style="{StaticResource BodyText}"/>
                            <TextBlock x:Name="StatSize" Grid.Column="1" FontSize="12"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource Ink}" Text="0 B"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Need review" Style="{StaticResource BodyText}"/>
                            <TextBlock x:Name="StatReview" Grid.Column="1" FontSize="12"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource Warn}" Text="0"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Blocked" Style="{StaticResource BodyText}"/>
                            <TextBlock x:Name="StatBlocked" Grid.Column="1" FontSize="12"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource Danger}" Text="0"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="TxtNothingSelected" Style="{StaticResource Subtitle}"
                               Margin="0,10,0,0" Text="Nothing selected."/>

                    <TextBlock Text="By location" FontSize="10" FontWeight="Medium"
                               Foreground="{StaticResource InkTertiary}" Margin="0,16,0,6"
                               x:Name="TxtByLocation"/>
                    <ItemsControl x:Name="LocationList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Location}"
                                               FontSize="11" Foreground="{StaticResource Ink}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Count}"
                                               FontSize="10" Foreground="{StaticResource InkTertiary}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}"
                                               FontSize="10" FontFamily="{StaticResource FontMono}"
                                               Foreground="{StaticResource InkSecondary}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="14,0,14,14">
                <Border x:Name="BlockedWarning" Visibility="Collapsed"
                        Background="{StaticResource DangerSoft}" CornerRadius="8"
                        Padding="9" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtBlockedWarning" FontSize="10"
                               Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
                </Border>

                <Button x:Name="BtnRemove" Content="Remove Selected" Click="BtnRemove_Click"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False"
                        HorizontalAlignment="Stretch" Padding="12,7"/>

                <TextBlock Style="{StaticResource Subtitle}" Margin="4,8,4,0"
                           Text="Removed items go to the Recycle Bin, so you can put them back if an app turns out to want them."/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
