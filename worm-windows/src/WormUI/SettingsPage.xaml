<Page x:Class="Worm.UI.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Settings">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Settings &amp; Configuration" 
                       FontSize="20" FontWeight="SemiBold" 
                       Foreground="{StaticResource WormIvoryText}"/>
            <TextBlock Text="Manage user protection rules, defaults, and system audit history." 
                       FontSize="12" 
                       Foreground="{StaticResource WormMutedText}" 
                       Margin="0,4,0,20"/>

            <!-- User Protect List Card -->
            <Border Background="{StaticResource WormLoamSurface}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Protect List" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource WormIvoryText}"/>
                    <TextBlock Text="Paths specified here and all subfolders are strictly prevented from deletion." 
                               FontSize="11" Foreground="{StaticResource WormMutedText}" Margin="0,2,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNewProtect" 
                                 ui:ControlHelper.PlaceholderText="e.g. %LOCALAPPDATA%\MyCustomTool or C:\MyData" 
                                 Grid.Column="0" Margin="0,0,8,0"/>
                        <Button x:Name="BtnAddProtect" Content="Add Path" Click="BtnAddProtect_Click" Grid.Column="1"/>
                    </Grid>

                    <ListBox x:Name="LstProtectedPaths" Height="120" Background="#151311" BorderBrush="#2A2622"/>
                    <Button x:Name="BtnRemoveProtect" Content="Remove Selected" Click="BtnRemoveProtect_Click" 
                            HorizontalAlignment="Right" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Clean Screen Card -->
            <Border Background="{StaticResource WormLoamSurface}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Clean Screen Mode" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource WormIvoryText}"/>
                    <TextBlock Text="Blanks every display so you can wipe the screen with a cloth without smearing it. Press Esc or click anywhere to exit."
                               FontSize="11" Foreground="{StaticResource WormMutedText}" Margin="0,2,0,12" TextWrapping="Wrap"/>
                    <Button x:Name="BtnCleanScreen" Content="Start Clean Screen"
                            Click="BtnCleanScreen_Click" HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Border>

            <!-- About Card -->
            <Border Background="{StaticResource WormLoamSurface}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="About Worm Cleaner for Windows" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource WormIvoryText}"/>
                    <!-- Version is set in code from the assembly, so it can never
                         drift from the build the way a hardcoded literal did. -->
                    <TextBlock x:Name="TxtAboutVersion"
                               FontSize="11" Foreground="{StaticResource WormMutedText}" Margin="0,4,0,10"/>
                    <TextBlock Text="Worm Cleaner is a free, open-source MacBook and Windows disk cleaner, app uninstaller and system monitor. No telemetry, no subscription, no upsell."
                               FontSize="11" Foreground="{StaticResource WormMutedText}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock Text="Not code-signed, so Windows SmartScreen may warn on first launch. Open source under the MIT License • Built with .NET 9 &amp; WPF."
                               FontSize="11" Foreground="{StaticResource WormMutedText}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="GitHub Repository" Click="OpenRepo_Click" Margin="0,0,8,0"/>
                        <Button Content="Open Logs Folder" Click="OpenLogs_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
