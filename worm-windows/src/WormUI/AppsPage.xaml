<Page x:Class="Worm.UI.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Apps"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Installed Apps" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="TxtHeader"
                       Style="{StaticResource Subtitle}"
                       Text="Reading the Windows uninstall registry. Removal runs the app's own uninstaller."/>
        </StackPanel>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtFilter"
                     Grid.Column="0"
                     Margin="0,0,10,0"
                     Padding="8,5"
                     FontSize="11"
                     Foreground="{StaticResource Ink}"
                     CaretBrush="{StaticResource Accent}"
                     Background="{StaticResource LoamBackground}"
                     BorderBrush="{StaticResource Hairline}"
                     BorderThickness="1"
                     TextChanged="TxtFilter_TextChanged"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="CmbSort" Width="110" SelectedIndex="0" Margin="0,0,8,0"
                          SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="Largest"/>
                    <ComboBoxItem Content="Name"/>
                </ComboBox>
                <Button x:Name="BtnRefresh" Content="Refresh" Click="BtnRefresh_Click"
                        Style="{StaticResource WormButton}"/>
            </StackPanel>
        </Grid>

        <!-- States -->
        <Grid Grid.Row="2">
            <!-- Loading -->
            <ContentControl x:Name="PanelLoading" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Empty -->
            <ContentControl x:Name="PanelEmpty" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Populated -->
            <Border x:Name="PanelList" Visibility="Collapsed"
                    Background="{StaticResource LoamSurface}"
                    CornerRadius="12" Padding="4">
                <DataGrid x:Name="AppsGrid" Style="{StaticResource WormDataGrid}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Remove"
                                                Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="False" Width="60"/>
                        <DataGridTextColumn Header="Application" Binding="{Binding Name}" IsReadOnly="True" Width="2.2*"/>
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" IsReadOnly="True" Width="1.4*"/>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="State" Binding="{Binding StateText}" IsReadOnly="True" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Action bar -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12"
                Background="{StaticResource LoamSurface}" CornerRadius="8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Selected: " Foreground="{StaticResource InkSecondary}" FontSize="12"/>
                    <TextBlock x:Name="TxtSelectedCount" Text="0"
                               Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="13"/>
                </StackPanel>
                <Button x:Name="BtnRemove" Content="Remove Selected" Click="BtnRemove_Click"
                        HorizontalAlignment="Right" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
